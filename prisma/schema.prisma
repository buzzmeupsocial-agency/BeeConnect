// Prisma schema — Dashboard Ratos
// Prisma ORM v7: driver adapter required, connection URL lives in prisma.config.ts, not here.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  META
  GOOGLE
}

enum ResultType {
  LEADS
  PURCHASES
}

enum SyncStatus {
  SUCCESS
  ERROR
}

// Mirrors Supabase auth.users. Row created by a Postgres trigger (see
// prisma/migrations/.../auth_trigger.sql) whenever a new user signs up.
model Profile {
  id        String   @id @db.Uuid
  email     String
  name      String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  clientAccess UserClientAccess[]

  @@map("profiles")
}

model Client {
  id                 String   @id @default(uuid()) @db.Uuid
  slug               String   @unique
  name               String
  currency           String   @default("BRL")
  metaAdAccountId    String? // e.g. "act_123456789"
  googleAdsCustomerId String? // no dashes, e.g. "1234567890"
  createdAt          DateTime @default(now())

  userAccess UserClientAccess[]
  campaigns  Campaign[]
  creatives  Creative[]
  syncRuns   SyncRun[]

  @@map("clients")
}

model UserClientAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  clientId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@map("user_client_access")
}

model Campaign {
  id         String     @id @default(uuid()) @db.Uuid
  clientId   String     @db.Uuid
  platform   Platform
  externalId String // Meta campaign id / Google campaign id
  name       String
  objective  String? // raw value from the platform (e.g. OUTCOME_LEADS, SEARCH)
  status     String?
  resultType ResultType // derived at sync time — decides which chart this campaign feeds
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  client    Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  metrics   CampaignDailyMetric[]
  creatives Creative[]

  @@unique([clientId, platform, externalId])
  @@map("campaigns")
}

model CampaignDailyMetric {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @db.Uuid
  date        DateTime @db.Date
  spend       Decimal  @default(0) @db.Decimal(14, 2)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  leads       Int      @default(0)
  purchases   Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(14, 2)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([date])
  @@map("campaign_daily_metrics")
}

// Meta only in v1 — Google Ads has no equivalent creative/asset read yet.
model Creative {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @db.Uuid
  campaignId   String?  @db.Uuid
  platform     Platform @default(META)
  externalId   String // creative id
  adId         String // ad id (insights are fetched at ad level)
  name         String?
  thumbnailUrl String?
  status       String?
  createdAt    DateTime @default(now())

  client  Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  metrics CreativeDailyMetric[]

  @@unique([clientId, platform, externalId])
  @@map("creatives")
}

model CreativeDailyMetric {
  id          String   @id @default(uuid()) @db.Uuid
  creativeId  String   @db.Uuid
  date        DateTime @db.Date
  spend       Decimal  @default(0) @db.Decimal(14, 2)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  purchases   Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(14, 2)

  creative Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@unique([creativeId, date])
  @@index([date])
  @@map("creative_daily_metrics")
}

model SyncRun {
  id             String     @id @default(uuid()) @db.Uuid
  clientId       String     @db.Uuid
  platform       Platform
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  status         SyncStatus?
  recordsSynced  Int        @default(0)
  error          String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, startedAt])
  @@map("sync_runs")
}
